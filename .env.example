# Sandbox credentials for the live E2E suite (pnpm test:e2e).
# Copy to .env — which is gitignored — and fill in from the SingaPay dashboard.
# `pnpm test` never reads any of this and never touches the network.

SINGAPAY_ENV=sandbox

# --- Primary credential -------------------------------------------------
# The credential that OWNS the sub-account below. SP403 means the account is
# served by a different credential, not that the account id is wrong: the
# dashboard's Credential Details page lists its Assigned Accounts.
SINGAPAY_CLIENT_ID=
SINGAPAY_CLIENT_SECRET=
# The dashboard calls this the API Key. It travels as the X-PARTNER-ID header,
# which is why SINGAPAY_PARTNER_ID is still accepted as an alias. Do NOT put
# the Client Secret here — that is the most common setup mistake, and it fails
# as an unexplained authentication error.
SINGAPAY_API_KEY=

# Sub-account ULID the suite operates on. Optional — merchant-wide calls work
# without it, and the account-scoped tests skip themselves when it is absent.
SINGAPAY_ACCOUNT_ID=

# --- Merchant-wide credential -------------------------------------------
# Registered as the connection named `merchant`. Optional; the two-credential
# tests skip themselves without it.
#
# This matters beyond convenience: a money-out notification is sent by the
# merchant Default credential even when the transfer was made with a Specific
# one. A verifier that only holds the calling credential's secret rejects
# those deliveries silently, in production.
#
# SINGAPAY_DEFAULT_* is accepted as an alias, because that is what the Laravel
# app's .env already calls these.
SINGAPAY_MERCHANT_CLIENT_ID=
SINGAPAY_MERCHANT_CLIENT_SECRET=
SINGAPAY_MERCHANT_API_KEY=

# --- Webhooks -----------------------------------------------------------
# HMAC Validation Key, for verifying inbound signatures.
#
# EVERY credential has its own key, and you need all of them: one callback URL
# receives deliveries signed by whichever credential sent them. A money-out
# notification arrives from the merchant Default credential even when the
# transfer was made with a Specific one, so listing only the Specific key makes
# those deliveries fail verification silently, in production.
#
# Put the Specific credential's key here and the merchant one below — or list
# them comma-separated in either variable. Every connection's client secret is
# already tried on top of these.
SINGAPAY_HMAC_KEY=
SINGAPAY_MERCHANT_HMAC_KEY=

# --- Money out ----------------------------------------------------------
# Off unless this is exactly `true`. A sandbox disbursement still moves a real
# sandbox balance, and the suite makes one transfer per run.
#
# The sandbox chooses the outcome from the account-number prefix: 1000, 1002,
# 1006, 1007, 1008 and 4000 succeed; 1001, 1003, 1004 and 1005 each fail a
# different way. The remaining digits are free but the total length must match
# the bank's, or the transfer hangs Pending forever. Failures settle 7-10
# minutes after successes, so Pending never means failed.
SINGAPAY_MONEY_OUT=false
